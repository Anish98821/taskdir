{
  "name": "@anish98821/taskdir",
  "version": "0.4.0",
  "description": "Local task substrate for AI coding agents. Filesystem-backed, MCP-native.",
  "license": "MIT",
  "repository": "github:Anish98821/taskdir",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "node scripts/bundle-mcp.mjs",
    "build:web": "next build && node scripts/build-web.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --experimental-strip-types --test src/**/*.test.ts",
    "mcp:stdio": "node --experimental-strip-types --no-warnings bin/taskdir-mcp.ts",
    "init": "node --experimental-strip-types --no-warnings bin/taskdir-init.ts",
    "prepack": "npm run build:cli && npm run build:web"
  },
  "bin": {
    "taskdir-init": "dist/bin/taskdir-init.js",
    "taskdir-mcp": "dist/bin/taskdir-mcp.js",
    "taskdir-web": "dist/bin/taskdir-web.js"
  },
  "files": [
    "dist/bin/taskdir-init.js",
    "dist/bin/taskdir-mcp.js",
    "dist/bin/taskdir-web.js",
    "dist/bin/package.json",
    "dist/web/",
    "AGENTS.md",
    "README.md",
    "banner.png"
  ],
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@uiw/react-codemirror": "^4.25.10",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
