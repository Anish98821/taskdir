{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist/bin",
    "rootDir": "bin",
    "declaration": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022"]
  },
  "include": ["bin/taskdir.ts"],
  "exclude": ["node_modules", "src", ".next"]
}
